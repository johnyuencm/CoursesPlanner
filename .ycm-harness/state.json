    "ticket-add-ctrl-f-find-on-the-prerequisite-map-6ba0b9a3": {
      "id": "ticket-add-ctrl-f-find-on-the-prerequisite-map-6ba0b9a3",
      "goal_id": "goal_complete-mscs-seattle-prerequisite-graph_5f65",
      "title": "Add Ctrl+F find on the prerequisite map",
      "brief": "Browser Ctrl+F cannot find off-screen React Flow nodes. The map needs an in-page find that focuses with Ctrl+F and jumps through matching courses.",
      "acceptance": [
        "On /map, Ctrl+F or Cmd+F focuses the graph find field and does not open the browser find bar.",
        "Typing a course code or title lists matches; Enter or F3 jumps to the next match and pans if it is on the current view.",
        "A query such as cs5500 or PHYS 5116 locates that course even when the node is off-screen; Escape clears the find field.",
        "npm test and npm run typecheck pass."
      ],
      "blocked_by": [],
      "status": "done",
      "code_changed": true,
      "order": 3,
      "created_at": "2026-09-13T03:34:35.501Z",
      "updated_at": "2026-09-13T08:01:43.466Z"
    },
