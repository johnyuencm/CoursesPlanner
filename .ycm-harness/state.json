  "local_tickets": {
    "ticket-show-the-full-mscs-seattle-prerequisite-graph-8e4a497f": {
      "id": "ticket-show-the-full-mscs-seattle-prerequisite-graph-8e4a497f",
      "goal_id": "goal_complete-mscs-seattle-prerequisite-graph_5f65",
      "title": "Show the full MSCS Seattle prerequisite graph",
      "brief": "Default Prerequisite Graph must render every official MSCS Seattle program course from the catalog page, including isolated courses with no prerequisites. Keep neighborhood zoom. Do not invent offerings. Restrict the published catalog graph to program courses plus their requirement closure so undergraduate bulk listings stop hiding the program.",
      "acceptance": [
        "Opening /map without changing filters shows every core, breadth, and elective course listed on the official MSCS Seattle program requirements page as a node, including CS 5800 and CS 5100 which have no parsed prerequisites.",
        "Direct external prerequisites of those program courses, such as CS 5004 for CS 5500, remain visible. Unrelated undergraduate CS listings such as CS 1800 are not in the published catalog snapshot.",
        "The Show control still offers Immediate neighborhood and that view of CS 5500 stays a local neighborhood rather than replacing the entire-program default.",
        "Grade floors such as C- parse as minimumGrade C- rather than an unknown hyphen token; npm test and npm run typecheck pass."
      ],
      "blocked_by": [],
      "status": "done",
      "code_changed": true,
      "order": 0,
      "created_at": "2026-09-12T06:05:54.100Z",
      "updated_at": "2026-09-13T08:01:35.919Z"
    },
    "ticket-lay-out-the-program-map-as-a-prerequisite-flow-bd746304": {
      "id": "ticket-lay-out-the-program-map-as-a-prerequisite-flow-bd746304",
      "goal_id": "goal_complete-mscs-seattle-prerequisite-graph_5f65",
      "title": "Lay out the program map as a prerequisite flow",
      "brief": "Default Prerequisite Graph should place cataloged prerequisites to the left of the courses they unlock, and inspector code chips should pan the camera to that course instead of only opening a dialog.",
      "acceptance": [
        "On the default entire-program map, CS 5004 and CS 5010 sit to the left of CS 5500, and CS 5500 sits to the left of CS 6510.",
        "Courses with no parsed arrows remain on the map packed below the connected flow; CS 5800 and CS 5100 are still present.",
        "Clicking a prerequisite or unlock chip in the map inspector selects that course and pans to it when it is on the current view; a chip for a course not on this view opens that course neighborhood.",
        "Immediate neighborhood of CS 5500 stays the local four-course set; npm test and npm run typecheck pass."
      ],
      "blocked_by": [],
      "status": "done",
      "code_changed": false,
      "order": 1,
      "created_at": "2026-09-12T19:18:49.959Z",
      "updated_at": "2026-09-12T19:45:33.382Z"
    },
    "ticket-show-titles-and-real-prerequisite-arrows-6c4ad3df": {
      "id": "ticket-show-titles-and-real-prerequisite-arrows-6c4ad3df",
      "goal_id": "goal_complete-mscs-seattle-prerequisite-graph_5f65",
      "title": "Show titles and real prerequisite arrows",
      "brief": "Entire-program map should keep course titles, draw arrows only for the selected course's parsed prerequisite chain, and sit a sole prerequisite immediately left of the course that names it.",
      "acceptance": [
        "Entire-program map nodes show the course title, not only the code.",
        "Unrelated neighbors are not visually linked: the entire-program map draws arrows only for the selected course's parsed prerequisite and unlock chain.",
        "A course that is the sole on-map prerequisite of another sits immediately left of it on the same row, with the arrow pointing at that course.",
        "Selecting PHYS 5116 shows only the arrow to CS 7332 and explains that CS 7332 named this external code; npm test and npm run typecheck pass."
      ],
      "blocked_by": [],
      "status": "done",
      "code_changed": true,
      "order": 2,
      "created_at": "2026-09-13T02:45:49.516Z",
