{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coursesplanner",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  // House rule: one custom domain per app under johnyc.com, no workers.dev URL.
  "routes": [{ "pattern": "coursesplanner.johnyc.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
