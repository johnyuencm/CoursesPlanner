{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coursesplanner",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // worker.ts sends unknown /courses/<slug> to the cheap 404, then calls vinext.
  "main": "./worker.ts",
  // House rule: one custom domain per app under johnyc.com, no workers.dev URL.
  "routes": [{ "pattern": "coursesplanner.johnyc.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*",
      // public/ icons: static assets answer them, the Worker never runs.
      "!/favicon.ico",
      "!/icon.svg"
    ]
  }
}
